# Public configuration — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Absolute origin used for canonical URLs, the sitemap, robots.txt and email links.
# Use the production origin in production (e.g. https://shilevi.app).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact addresses shown on legal, support and security pages.
# Replace these before launch; the defaults are placeholders.
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_PRIVACY_EMAIL=
NEXT_PUBLIC_SECURITY_EMAIL=

# Server-only secrets belong in untracked local env files or Vercel server-side environment settings.
# Never prefix these with NEXT_PUBLIC_.
# Required for provider callbacks, payout settlement and the notification dispatcher.
# SUPABASE_SERVICE_ROLE_KEY=

# Safaricom Daraja (M-Pesa). MPESA_ENV must be "sandbox" or "production".
# All five STK values are required before a charge can start; the route fails closed otherwise.
# MPESA_ENV=sandbox
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_SHORTCODE=
# MPESA_PASSKEY=
# MPESA_CALLBACK_URL=https://shilevi.app/api/payments/mpesa/callback
# MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# MPESA_VERIFY_CALLBACK=true

# Daraja B2C payouts. Required only to dispatch withdrawals; without them payouts stay pending.
# MPESA_B2C_INITIATOR=
# MPESA_B2C_SECURITY_CREDENTIAL=
# MPESA_B2C_SHORTCODE=
# MPESA_B2C_RESULT_URL=https://shilevi.app/api/payments/mpesa/b2c-result
# MPESA_B2C_TIMEOUT_URL=https://shilevi.app/api/payments/mpesa/b2c-result

# Resend transactional email. Auth email is configured separately in Supabase SMTP settings.
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=Shilevi <no-reply@shilevi.com>
# NOTIFICATION_DISPATCH_SECRET=

# Live RLS negative tests (npm run test:rls:live). The app never reads these; point the Supabase
# variables above at a disposable staging project before running the suite.
# SHILEVI_RLS_ALLOW_LIVE=1
# SHILEVI_RLS_KEEP_DATA=1
