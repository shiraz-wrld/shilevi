# Shilevi environment template
#
# Copy this file to `.env.local` for local development, or enter the same names in
# Vercel → Project → Settings → Environment Variables for Preview and Production.
# Only placeholders belong in this file. Never commit a real credential.
#
# Browser-visible variables must be prefixed NEXT_PUBLIC_. Anything without that prefix is
# server-only and must never be imported by a client component or bundled into the browser.
# Next.js inlines NEXT_PUBLIC_ values at build time, so changing one requires a new build.

# ---------------------------------------------------------------------------
# Public configuration (safe to expose to the browser)
# ---------------------------------------------------------------------------

# Supabase project URL and publishable/anon key.
# Project: shilevi pr 1 · reference kdygwbymgpmssuszhski · West EU (Ireland).
# The publishable key is designed to be public; the service-role key is NOT (see below).
NEXT_PUBLIC_SUPABASE_URL=https://kdygwbymgpmssuszhski.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key

# Absolute origin used for canonical URLs, the sitemap, robots.txt, OpenGraph and email links.
# Use the production origin in production (for example https://shilevi.app).
# If unset, Vercel's own URL is used at build time, falling back to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact addresses shown on the legal, support and security pages.
# Replace these before launch; the defaults are placeholders and the mailboxes may not exist.
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com
NEXT_PUBLIC_PRIVACY_EMAIL=privacy@example.com
NEXT_PUBLIC_SECURITY_EMAIL=security@example.com

# ---------------------------------------------------------------------------
# Server-only secrets — never prefix these with NEXT_PUBLIC_
# ---------------------------------------------------------------------------

# Bypasses row-level security. Required for verified payment callbacks, B2C payouts, trusted
# search-analytics writes and the notification dispatcher. Treat it as a master key.
# SUPABASE_SERVICE_ROLE_KEY=

# Safaricom Daraja (M-Pesa STK push). All five of MPESA_CONSUMER_KEY, MPESA_CONSUMER_SECRET,
# MPESA_SHORTCODE, MPESA_PASSKEY and MPESA_CALLBACK_URL are required before a charge can start;
# the route fails closed with HTTP 503 otherwise. MPESA_ENV is "sandbox" or "production".
# MPESA_ENV=sandbox
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_SHORTCODE=
# MPESA_PASSKEY=
# MPESA_CALLBACK_URL=https://<your-domain>/api/payments/mpesa/callback
# MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# MPESA_VERIFY_CALLBACK=true

# Daraja B2C payouts. Required only to dispatch withdrawals; without them payouts stay pending.
# MPESA_B2C_INITIATOR=
# MPESA_B2C_SECURITY_CREDENTIAL=
# MPESA_B2C_SHORTCODE=
# MPESA_B2C_RESULT_URL=https://<your-domain>/api/payments/mpesa/b2c-result
# MPESA_B2C_TIMEOUT_URL=https://<your-domain>/api/payments/mpesa/b2c-result

# Resend transactional email (order and application notifications).
# Auth email (verification, password recovery) is configured separately in Supabase SMTP.
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=Shilevi <no-reply@example.com>

# Bearer secret for POST /api/notifications/dispatch. Without it the endpoint refuses to run.
# NOTIFICATION_DISPATCH_SECRET=

# ---------------------------------------------------------------------------
# Development and verification only (never needed by the deployed application)
# ---------------------------------------------------------------------------

# Live RLS negative tests: `npm run test:rls:live`. The app never reads these.
# Point the Supabase variables above at a disposable STAGING project first — the suite creates
# and deletes test accounts. SHILEVI_RLS_ALLOW_LIVE=1 is the explicit safety interlock.
# SHILEVI_RLS_ALLOW_LIVE=1
# SHILEVI_RLS_KEEP_DATA=1

# Base URL for the HTTP audit: `BASE_URL=http://127.0.0.1:3100 npm run verify:routes`.
# BASE_URL=http://127.0.0.1:3100
